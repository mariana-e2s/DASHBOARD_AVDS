rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /User/{document} {
      allow create: if true;
      allow read: if request.auth != null;
      allow write: if request.auth.uid == resource.data.uid;
      allow delete: if false;
    }

    match /UserExercicio/{document} {
      allow create: if request.auth != null;
      allow read: if resource.data.UserID == /databases/$(database)/documents/User/$(request.auth.uid);
      allow write: if resource.data.UserID == /databases/$(database)/documents/User/$(request.auth.uid);
      allow delete: if resource.data.UserID == /databases/$(database)/documents/User/$(request.auth.uid);
    }

    match /Dor/{document} {
      allow create: if request.auth != null;
      allow read: if resource.data.UserID == /databases/$(database)/documents/User/$(request.auth.uid);
      allow write: if resource.data.UserID == /databases/$(database)/documents/User/$(request.auth.uid);
      allow delete: if resource.data.UserID == /databases/$(database)/documents/User/$(request.auth.uid);
    }

    match /Sono/{document} {
      allow create: if request.auth != null;
      allow read: if resource.data.UserID == /databases/$(database)/documents/User/$(request.auth.uid);
      allow write: if resource.data.UserID == /databases/$(database)/documents/User/$(request.auth.uid);
      allow delete: if resource.data.UserID == /databases/$(database)/documents/User/$(request.auth.uid);
    }

    match /Medicacao/{document} {
      allow create: if request.auth != null;
      allow read: if resource.data.UserID == /databases/$(database)/documents/User/$(request.auth.uid);
      allow write: if resource.data.UserID == /databases/$(database)/documents/User/$(request.auth.uid);
      allow delete: if resource.data.UserID == /databases/$(database)/documents/User/$(request.auth.uid);
    }

    match /SOS/{document} {
      allow create: if request.auth != null;
      allow read: if resource.data.userID == /databases/$(database)/documents/User/$(request.auth.uid);
      allow write: if resource.data.userID == /databases/$(database)/documents/User/$(request.auth.uid);
      allow delete: if resource.data.userID == /databases/$(database)/documents/User/$(request.auth.uid);
    }

    match /ExercicioRecomendado/{document} {
      allow create: if false;
      allow read: if request.auth != null;
      allow write: if false;
      allow delete: if false;
    }

    match /GamificacaoUser/{document} {
      allow create: if request.auth != null;
      allow read: if resource.data.UserID == /databases/$(database)/documents/User/$(request.auth.uid);
      allow write: if resource.data.UserID == /databases/$(database)/documents/User/$(request.auth.uid);
      allow delete: if resource.data.UserID == /databases/$(database)/documents/User/$(request.auth.uid);
    }
  }
}